# Copy to .env only if it does not exist; keep real keys out of source control.
LLM_PROVIDER=qwen
# Alibaba Model Studio: use the endpoint shown for your key's workspace/region.
# This service is usage-based; supply your own key only in the private .env.
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=qwen-flash

# Free alternative: set LLM_PROVIDER=groq.
# Create a key at https://console.groq.com/keys and keep the account on Free Plan.
# The provider account plan determines billing; a model ID alone is not free.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_REASONING_EFFORT=none
GROQ_REASONING_FORMAT=hidden

# Optional PAID alternative: set LLM_PROVIDER=huggingface.
HF_TOKEN=
HF_MODEL=deepseek-ai/DeepSeek-V4-Flash:deepinfra
# Non-thinking mode for short support/JSON tasks. Leave empty for models that
# do not support reasoning_effort.
HF_REASONING_EFFORT=none

# Alternative: set LLM_PROVIDER=anthropic and fill these instead.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Optional Anthropic-compatible provider endpoint:
ANTHROPIC_BASE_URL=
ECHOMIND_ENV=development
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
REDIS_URL=redis://localhost:6379/0
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=./data/chroma
ECHOMIND_SEED_DEMO_DOCS=false
MCP_EXTERNAL_ENABLED=false
EVAL_BASELINE_PATH=./data/eval/baseline.json
PROMETHEUS_PORT=0
LOG_LEVEL=INFO
# Inherited ECHOMIND_* names are retained for compatibility.
# Production additionally requires ECHOMIND_API_TOKENS; see core/access.py.
